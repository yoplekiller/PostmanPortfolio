        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Status is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"All delivery_types flags are false\", function () {\r",
              "    const d = jsonData.delivery_types;\r",
              "    pm.expect(Object.values(d).every(v => v === false)).to.eql(true);\r",
              "});\r",
              "\r",
              "pm.test(\"Case 4: OPEN but no method available -> not orderable\", function () {\r",
              "    const d = jsonData.delivery_types;\r",
              "    const hasAnyMethod = d.store_delivery || d.baemin_delivery || d.saving_delivery || d.pickup || d.dine_in;\r",
              "    const isOrderable = jsonData.shop_status === \"OPEN\" && hasAnyMethod;\r",
              "\r",
              "    pm.expect(isOrderable).to.eql(false);\r",
              "});\r",
              "\r",
              "pm.test(\"Delivery fee is null when no method is available\", function () {\r",
              "    pm.expect(jsonData.delivery_fee).to.eql(null);\r",
              "});"
            ],
